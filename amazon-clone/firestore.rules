rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile, cart and wishlist: owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // email -> auth provider, used by the sign-in page before anyone is
    // authenticated. Single-document reads only; no listing.
    match /emailIndex/{email} {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow list, delete: if false;
    }

    // Product page order counts. Nothing in the app writes orders yet.
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Customer reviews: public to read, signed-in users write their own.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
